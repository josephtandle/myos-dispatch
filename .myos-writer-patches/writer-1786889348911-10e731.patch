+test("searchScope resolves against capability scan_dir when MYOS_HOME_ROOT workspace differs", () => {
+  const homeRoot = fs.mkdtempSync(path.join(os.tmpdir(), "myos-home-diff-"));
+  const externalRepo = fs.mkdtempSync(path.join(os.tmpdir(), "myos-ext-repo-"));
+  try {
+    initRepo(externalRepo);
+    const skillDir = path.join(externalRepo, "skills", "deploy-external");
+    fs.mkdirSync(skillDir, { recursive: true });
+    const skillPath = path.join(skillDir, "SKILL.md");
+    fs.writeFileSync(skillPath, "---\nname: deploy-external\ndescription: Deploy external service\n---\n", "utf8");
+
+    const workspace = path.join(homeRoot, "workspace");
+    fs.mkdirSync(workspace, { recursive: true });
+    const indexData = {
+      scan_dir: externalRepo,
+      capabilities: [
+        {
+          id: "skill:deploy-external",
+          type: "skill",
+          execution_lane: "worker_skill",
+          source_path: path.join("skills", "deploy-external", "SKILL.md"),
+          description: "Deploy external service",
+          aliases: ["deploy-external"],
+          use_when: ["deploy external service"],
+          priority: 40,
+        },
+      ],
+      lanes: {},
+    };
+    fs.writeFileSync(path.join(workspace, "capabilities-index.json"), JSON.stringify(indexData), "utf8");
+
+    const origHome = process.env.MYOS_HOME_ROOT;
+    process.env.MYOS_HOME_ROOT = homeRoot;
+    delete require.cache[require.resolve("../src/workspace-context")];
+    delete require.cache[require.resolve("../src/capability-router")];
+
+    const { resolveDispatchPlan } = require("../src/workspace-context");
+    const plan = resolveDispatchPlan("deploy external service");
+    const target = resolveRepositoryTarget("deploy external service", plan);
+
+    assert.equal(target.reason, "scope_belongs_to_single_repository");
+    assert.equal(target.taskScope, path.resolve(skillPath));
+    assert.equal(target.primaryTarget.gitRoot, path.resolve(externalRepo));
+    assert.notEqual(target.reason, "no_git_repository");
+
+    if (origHome) process.env.MYOS_HOME_ROOT = origHome;
+    else delete process.env.MYOS_HOME_ROOT;
+  } finally {
+    fs.rmSync(homeRoot, { recursive: true, force: true });
+    fs.rmSync(externalRepo, { recursive: true, force: true });
+  }
+});
+
