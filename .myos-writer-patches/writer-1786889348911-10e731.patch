+test("parseFrontmatter and buildIndex support block scalars | and > and produce real text", () => {
+  const { parseFrontmatter } = require("../scripts/generate-index.js");
+  const contentLiteral = "---\r\nname: literal-skill\r\ndescription: |\r\n  First paragraph line 1.\r\n  First paragraph line 2.\r\n\r\n  Second paragraph line 1.\r\n---\r\n";
+  const contentFolded = "---\nname: folded-skill\ndescription: >\n  First folded paragraph line 1.\n  First folded paragraph line 2.\n\n  Second folded paragraph line 1.\n---\n";
+
+  const parsedLit = parseFrontmatter(contentLiteral);
+  assert.strictEqual(parsedLit.description, "First paragraph line 1.\nFirst paragraph line 2.\n\nSecond paragraph line 1.");
+
+  const parsedFold = parseFrontmatter(contentFolded);
+  assert.strictEqual(parsedFold.description, "First folded paragraph line 1. First folded paragraph line 2.\n\nSecond folded paragraph line 1.");
+
+  const scanDir = tmpDir("mdx-block-scalar-");
+  try {
+    const skill1 = path.join(scanDir, "skills", "literal-skill");
+    fs.mkdirSync(skill1, { recursive: true });
+    fs.writeFileSync(path.join(skill1, "SKILL.md"), contentLiteral, "utf8");
+
+    const skill2 = path.join(scanDir, "skills", "folded-skill");
+    fs.mkdirSync(skill2, { recursive: true });
+    fs.writeFileSync(path.join(skill2, "SKILL.md"), contentFolded, "utf8");
+
+    const { index } = buildIndex(scanDir);
+    for (const cap of index.capabilities) {
+      assert.notEqual(cap.description, "|");
+      assert.notEqual(cap.description, ">");
+      assert.ok(!cap.description.startsWith("|"));
+      assert.ok(!cap.description.startsWith(">"));
+      assert.ok(cap.description.length > 5);
+    }
+  } finally {
+    fs.rmSync(scanDir, { recursive: true, force: true });
+  }
+});
+
