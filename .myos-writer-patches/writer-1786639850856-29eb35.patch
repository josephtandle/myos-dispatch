+    if (escaped) {
+      currentToken += char;
+      escaped = false;
+      continue;
+    }
+
+    if (char === "\\") {
+      if (inSingleQuote) {
+        currentToken += char;
+      } else {
+        escaped = true;
+      }
+      continue;
+    }
+
+    if (char === "'" && !inDoubleQuote) {
+      inSingleQuote = !inSingleQuote;
+      currentToken += char;
+      continue;
+    }
+
+    if (char === '"' && !inSingleQuote) {
+      inDoubleQuote = !inDoubleQuote;
+      currentToken += char;
+      continue;
+    }
+
+    if (inSingleQuote || inDoubleQuote) {
+      if (char === "`" || (char === "$" && i + 1 < cmd.length && cmd[i + 1] === "(")) {
