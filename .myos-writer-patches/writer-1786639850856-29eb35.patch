+function hasGrepPathOperand(args) {
+  let hasPatternOption = false;
+  const nonOptionArgs = [];
+  let i = 0;
+  let inOptions = true;
+
+  while (i < args.length) {
+    const arg = unquoteToken(args[i]);
+
+    if (!inOptions) {
+      nonOptionArgs.push(arg);
+      i++;
+      continue;
+    }
+
+    if (arg === "--") {
+      inOptions = false;
+      i++;
+      continue;
+    }
+
+    if (arg.startsWith("--")) {
+      if (arg.includes("=")) {
+        const optName = arg.slice(0, arg.indexOf("="));
+        if (optName === "--regexp" || optName === "--file") {
+          hasPatternOption = true;
+        }
+        i++;
+      } else if (
+        arg === "--regexp" ||
+        arg === "--file" ||
+        arg === "--after-context" ||
+        arg === "--before-context" ||
+        arg === "--context" ||
+        arg === "--max-count" ||
+        arg === "--exclude" ||
+        arg === "--exclude-from" ||
+        arg === "--exclude-dir" ||
+        arg === "--include" ||
+        arg === "--label" ||
+        arg === "--directories" ||
+        arg === "--devices" ||
+        arg === "--binary-files" ||
+        arg === "--color" ||
+        arg === "--colour"
+      ) {
+        if (arg === "--regexp" || arg === "--file") {
+          hasPatternOption = true;
+        }
+        i++;
+        if (i < args.length && !args[i].startsWith("-")) {
+          i++;
+        }
+      } else {
+        i++;
+      }
+      continue;
+    }
+
+    if (arg.startsWith("-") && arg.length > 1) {
+      let j = 1;
+      let consumedNext = false;
+      while (j < arg.length) {
+        const char = arg[j];
+        if (
+          char === "e" ||
+          char === "f" ||
+          char === "A" ||
+          char === "B" ||
+          char === "C" ||
+          char === "m" ||
+          char === "d" ||
+          char === "D"
+        ) {
+          if (char === "e" || char === "f") {
+            hasPatternOption = true;
+          }
+          if (j + 1 < arg.length) {
+            j = arg.length;
+          } else {
+            consumedNext = true;
+          }
+          break;
+        }
+        j++;
+      }
+      i++;
+      if (consumedNext) {
+        i++;
+      }
+      continue;
+    }
