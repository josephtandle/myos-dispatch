#!/usr/bin/env node
"use strict";

const crypto = require("node:crypto");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const { spawnSync, spawn } = require("node:child_process");

const WORKSPACE_ROOT = path.resolve(__dirname, "..");
const {
  resolveDispatchPlan,
} = require(path.join(WORKSPACE_ROOT, "src/workspace-context"));
const { preferredHomeRoot, resolveLogsRoot } = require(path.join(WORKSPACE_ROOT, "src/myos-compat"));
const {
  buildGoalPolicy,
} = require(path.join(WORKSPACE_ROOT, "src/orchestration/execution-envelope"));

const EVENT_LABELS = {
  SessionStart: "session_start",
  PreToolUse: "pre_tool_use",
  PostToolUse: "post_tool_use",
  UserPromptSubmit: "user_prompt_submit",
  PreCompact: "pre_compact",
  PostCompact: "post_compact",
  Stop: "stop",
};

// Codex emits snake_case hook event names; normalize both spellings.
const EVENT_ALIASES = Object.fromEntries(
  Object.entries(EVENT_LABELS).map(([camel, snake]) => [snake, camel])
);

function safeString(value) {
  return typeof value === "string" ? value : "";
}

function readStdin() {
  return fs.readFileSync(0, "utf8");
}

function parseJsonInput(raw) {
  if (!raw.trim()) return {};
  return JSON.parse(raw);
}

function readArg(name, fallback = "") {
  const prefix = `${name}=`;
  for (const arg of process.argv.slice(2)) {
    if (arg === name) return "1";
    if (arg.startsWith(prefix)) return arg.slice(prefix.length);
  }
  return fallback;
}

function readSurface() {
  return readArg("--surface", process.env.MYOS_DISPATCH_HOOK_SURFACE || "unknown");
}

function readContextMode() {
  const mode = readArg("--context", process.env.MYOS_DISPATCH_HOOK_CONTEXT || "full").trim();
  return mode === "compact" || mode === "none" ? mode : "full";
}

function readRewriteEnabled() {
  // RTK rewrite is opt-in per surface (currently Claude only). Codex keeps
  // its own PreToolUse rewrite ownership, so we never emit updatedInput there.
  if (readArg("--no-rewrite") === "1") return false;
  return readArg("--rewrite") === "1";
}

function readHookEventName(payload) {
  const raw = safeString(
    payload.hook_event_name ||
    payload.hookEventName ||
    payload.event ||
    payload.name
  ).trim();
  if (EVENT_LABELS[raw]) return raw;
  if (EVENT_ALIASES[raw]) return EVENT_ALIASES[raw];
  if (payload.tool_input || payload.toolInput || payload.tool_name || payload.toolName) {
    return "PreToolUse";
  }
  if (payload.prompt || payload.user_prompt || payload.userPrompt) {
    return "UserPromptSubmit";
  }
  return "";
}

function readPromptText(payload) {
  const candidates = [
    payload.prompt,
    payload.user_prompt,
    payload.userPrompt,
    payload.text,
    payload.input,
  ];
  for (const candidate of candidates) {
    const value = safeString(candidate).trim();
    if (value) return value;
  }
  return "";
}

function readSessionId(payload) {
  const raw = safeString(
    payload.session_id ||
    payload.sessionId ||
    payload.conversation_id ||
    payload.conversationId
  ).trim();
  // The id becomes a directory name under state/sidecar-results. Hook stdin is
  // untrusted, so strip anything that could traverse out of the spool and cap
  // the length; a real Claude Code session id is a UUID and passes unchanged.
  const cleaned = raw.replace(/[^A-Za-z0-9._-]/g, "_").replace(/^\.+/, "_").slice(0, 128);
  return cleaned || "default-session";
}

function getRawSessionId(payload) {
  if (!payload || typeof payload !== "object") return "";
  const raw = safeString(
    payload.session_id ||
    payload.sessionId ||
    payload.conversation_id ||
    payload.conversationId
  ).trim();
  if (!raw) return "";
  const cleaned = raw.replace(/[^A-Za-z0-9._-]/g, "_").replace(/^\.+/, "_").slice(0, 128);
  return cleaned;
}

function getRouteContextStateDir() {
  return path.join(preferredHomeRoot(), "state", "route-context");
}

function pruneOldRouteContextStateFiles(dir) {
  try {
    if (!fs.existsSync(dir)) return;
    const files = fs.readdirSync(dir);
    const now = Date.now();
    const maxAgeMs = 7 * 24 * 60 * 60 * 1000;
    for (const file of files) {
      if (!file.endsWith(".json")) continue;
      const fullPath = path.join(dir, file);
      try {
        const stat = fs.statSync(fullPath);
        if (now - stat.mtimeMs > maxAgeMs) {
          fs.unlinkSync(fullPath);
        }
      } catch {}
    }
  } catch {}
}

function loadRouteContextState(sessionId) {
  if (!sessionId) return null;
  const dir = getRouteContextStateDir();
  const filePath = path.join(dir, `${sessionId}.json`);
  try {
    if (fs.existsSync(filePath)) {
      const raw = fs.readFileSync(filePath, "utf8");
      const parsed = JSON.parse(raw);
      if (parsed && typeof parsed === "object") {
        return {
          turn: typeof parsed.turn === "number" ? parsed.turn : 0,
          footerEmittedInTurn: Boolean(parsed.footerEmittedInTurn),
          lastEmittedHash: typeof parsed.lastEmittedHash === "string" ? parsed.lastEmittedHash : null,
        };
      }
    }
  } catch {}
  return null;
}

function saveRouteContextState(sessionId, state) {
  if (!sessionId || !state) return;
  const dir = getRouteContextStateDir();
  try {
    fs.mkdirSync(dir, { recursive: true });
    pruneOldRouteContextStateFiles(dir);
    const filePath = path.join(dir, `${sessionId}.json`);
    const tmpPath = path.join(dir, `${sessionId}.${process.pid}.${Date.now()}.${Math.random().toString(36).slice(2)}.tmp`);
    fs.writeFileSync(tmpPath, JSON.stringify(state, null, 2), "utf8");
    fs.renameSync(tmpPath, filePath);
  } catch {}
}

function readToolName(payload) {
  return safeString(payload.tool_name || payload.toolName || payload.tool || "").trim();
}

function readToolInput(payload) {
  const input = payload.tool_input || payload.toolInput || {};
  return input && typeof input === "object" ? input : {};
}

function readCommand(payload) {
  return safeString(readToolInput(payload).command || payload.command).trim();
}

function sha256(value) {
  return crypto.createHash("sha256").update(String(value || "")).digest("hex");
}

function extractFastpaths(plan) {
  if (!plan || !Array.isArray(plan.fastpathMatches) || plan.fastpathMatches.length === 0) {
    return undefined;
  }
  const identifiers = [];
  for (const match of plan.fastpathMatches) {
    if (!match) continue;
    const fp = match.fastpath || match;
    const capId = typeof fp.capability_id === "string" ? fp.capability_id.trim() : "";
    const intent = typeof fp.intent === "string" ? fp.intent.trim() : "";
    const id = capId || intent;
    if (id && !identifiers.includes(id)) {
      identifiers.push(id);
      if (identifiers.length >= 5) break;
    }
  }
  return identifiers.length > 0 ? identifiers : undefined;
}

function compactRoute(plan) {
  const parallel = plan?.parallelizationPlan || {};
  const tasks = Array.isArray(parallel.backgroundTasks)
    ? parallel.backgroundTasks.map((task) => ({
        id: task.id || "",
        role: task.role || task.kind || "",
        agentProfile: task.agentProfile || "",
        fallbackAgentProfile: task.fallbackAgentProfile || "",
        mode: task.mode || "read_only",
        required: Boolean(task.required),
        joinPolicy: task.joinPolicy || "optional_before_final",
        scope: task.scope || "",
        prompt: task.prompt || "",
        executionEnvelope: task.executionEnvelope || null,
      }))
    : [];
  const nativeTasks = tasks.filter((task) => task.mode !== "workspace_write");
  const runnerOwnedWritableTasks = tasks.filter((task) => task.mode === "workspace_write");
  const orchestrationEnabled = parallel.executionEnvelope?.enabled !== false;
  for (const task of nativeTasks) {
    if (!orchestrationEnabled && task.fallbackAgentProfile) {
      task.agentProfile = task.fallbackAgentProfile;
    }
  }
  const fastpaths = extractFastpaths(plan);
  return {
    branch: plan?.branch || "",
    intentType: plan?.intentType || "",
    actionType: plan?.actionType || "",
    goalScale: plan?.goalScale || null,
    goalMode: plan?.goalMode || "",
    requiresPlan: Boolean(plan?.requiresPlan),
    requiresApproval: Boolean(plan?.requiresApproval),
    blockedBy: Array.isArray(plan?.blockedBy) ? plan.blockedBy : [],
    stopAfterMatch: Boolean(plan?.stopAfterMatch),
    allowBroadSearch: Boolean(plan?.allowBroadSearch),
    projectSlug: plan?.projectSlug || null,
    searchScope: plan?.searchScope || "",
    // Logged so the evolver can count what actually matched. Without it the log
    // records a lane, and no faithful bridge from log to observer is possible.
    capabilityId: plan?.capabilityId || null,
    ...(fastpaths ? { fastpaths } : {}),
    dataSources: Array.isArray(plan?.dataSources) ? plan.dataSources : [],
    route: {
      lane: plan?.route?.lane || "",
      reason: plan?.route?.reason || "",
    },
    parallelization: {
      version: parallel.version || "",
      mode: parallel.mode || "none",
      aggression: parallel.aggression || "off",
      depth: parallel.depth ?? 0,
      criticalPath: parallel.criticalPath || "",
      taskCount: tasks.length,
      nativeTaskCount: nativeTasks.length,
      runnerOwnedWritableTaskCount: runnerOwnedWritableTasks.length,
      tasks,
      blockedReasons: Array.isArray(parallel.blockedReasons) ? parallel.blockedReasons : [],
      maxSidecars: parallel.budget?.maxSidecars ?? null,
      joinPolicy: parallel.joinPolicy || "none",
      activeStage: parallel.promotion?.activeStage || "",
      repositoryRouting: parallel.repositoryRouting || null,
      orchestrationLevel: parallel.executionEnvelope?.level || "",
      orchestrationEnabled,
      intentHorizon: parallel.executionEnvelope?.features?.intentHorizon || null,
    },
    typedEvidence: {
      authoritative: Boolean(plan?.shadowDispatch?.authoritative),
      activeStage: plan?.shadowDispatch?.activeStage || "",
    },
  };
}

function formatList(values) {
  return values && values.length ? values.join(", ") : "none";
}

function surfaceFanoutInstruction(surface, parallel, autoDispatchedTasks = []) {
  if (parallel.mode === "none" || parallel.nativeTaskCount === 0) return "";
  if (surface === "codex") {
    return `- Codex: spawn the ${parallel.nativeTaskCount} read-only lane(s) listed above as native multi-agent threads now. Use the preferred custom agent when available, otherwise its fallback. Never run a runner-owned writable lane in a shared-workspace native thread.`;
  }
  if (autoDispatchedTasks.length > 0) {
    const autoIds = autoDispatchedTasks.map((t) => t.id).join(", ");
    const autoLine = `- Claude: ${autoDispatchedTasks.length} read-only lane(s) (${autoIds}) are ALREADY RUNNING in the background and results will arrive next turn. Do not re-spawn them; work the critical path.`;
    const allTasks = parallel.tasks || [];
    const remainingTasks = allTasks.filter(
      (t) => !autoDispatchedTasks.some((a) => a.id === t.id)
    );
    if (remainingTasks.length > 0) {
      const remIds = remainingTasks.map((t) => t.id).join(", ");
      return `${autoLine}\n- Claude: launch the remaining ${remainingTasks.length} independent lane(s) (${remIds}) as parallel Agent calls in a single message before serial work on the critical path.`;
    }
    return autoLine;
  }
  if (surface === "claude") {
    return "- Claude: launch the independent lanes as parallel Agent calls in a single message before serial work on the critical path.";
  }
  return "- Launch the independent lanes as parallel background subagents before serial work on the critical path.";
}

function fanoutMandateLines(surface, parallel, autoDispatchedTasks = []) {
  if ((parallel.blockedReasons || []).includes("background_agents_disabled")) {
    return ["- Background fan-out is disabled on this machine (MYOS_BACKGROUND_AGENTS_ENABLED=0). Work the critical path in this session and do not spawn background subagents."];
  }
  const lines = [
    "- Fan out FIRST on non-trivial work: dispatch the parallel lanes above at the start of the turn, then work the critical path while they run.",
    "- Prefer breadth over depth: many parallel single-purpose subagents, shallow nesting. Never chain subagents deeper than the depth shown; widen instead.",
  ];
  const surfaceLine = surfaceFanoutInstruction(surface, parallel, autoDispatchedTasks);
  if (surfaceLine) lines.push(surfaceLine);
  if (parallel.mode !== "none" && parallel.nativeTaskCount > 0 && parallel.nativeTaskCount < 3 && autoDispatchedTasks.length === 0) {
    lines.push("- The plan exposes fewer than 3 lanes; if the task is multi-part, widen the fanout yourself within the same gates.");
  }
  return lines;
}

function formatLaneAssignments(surface, parallel) {
  if (!Array.isArray(parallel.tasks) || parallel.tasks.length === 0) return [];
  const scopes = parallel.tasks.map((task) => safeString(task.scope).trim());
  const firstScope = scopes[0];
  const allSameScope = firstScope !== "" && scopes.every((s) => s === firstScope);

  const lines = [];
  if (allSameScope) {
    lines.push(`Lane scope: ${firstScope}`);
  }
  lines.push("Lane assignments:");
  for (const task of parallel.tasks) {
    const owner = task.mode === "workspace_write"
      ? "runner-owned isolated worktree"
      : surface === "codex"
        ? `native:${task.agentProfile || task.fallbackAgentProfile || "explorer"}`
        : "provider-affine read-only sidecar";
    const scopeStr = !allSameScope && task.scope ? ` scope=${task.scope}` : "";
    lines.push(
      `- ${task.id} role=${task.role || "context"} mode=${task.mode} owner=${owner} ` +
      `join=${task.joinPolicy}${task.required ? " required" : ""}` +
      scopeStr
    );
  }
  return lines;
}

function formatDispatchContext({ surface, hookEventName, targetKind, text, plan, autoDispatchedTasks = [], state = null }) {
  const route = compactRoute(plan);
  const parallel = route.parallelization;
  const goalPolicy = buildGoalPolicy(text, plan);
  const bodyLines = [
    "[MyOS Dispatch route]",
    `Surface: ${surface}`,
    `Hook event: ${hookEventName}`,
    `Target: ${targetKind}`,
    `Input hash: sha256:${sha256(text).slice(0, 16)} length=${text.length}`,
    `Branch: ${route.branch}`,
    `Intent/action: ${route.intentType}/${route.actionType}`,
    `Execution lane: ${route.route.lane || "worker_skill"}`,
    route.route.reason ? `Lane reason: ${route.route.reason}` : "",
    `Goal: ${route.goalScale || "n/a"} ${route.goalMode || ""}`.trim(),
    `Project: ${route.projectSlug || "none"}`,
    route.searchScope ? `Search scope: ${route.searchScope}` : "",
    route.dataSources.length ? `Data sources: ${formatList(route.dataSources)}` : "",
    `Stop after match: ${route.stopAfterMatch ? "yes" : "no"}`,
    `Allow broad search: ${route.allowBroadSearch ? "yes" : "no"}`,
    `Requires plan: ${route.requiresPlan ? "yes" : "no"}`,
    `Requires approval: ${route.requiresApproval ? "yes" : "no"}`,
    route.blockedBy.length ? `Blocked by: ${formatList(route.blockedBy)}` : "",
    `Fanout: ${parallel.mode}, aggression=${parallel.aggression}, depth=${parallel.depth}, sidecars=${parallel.taskCount}/${parallel.maxSidecars ?? "?"}, join=${parallel.joinPolicy}`,
    `Native read-only lanes: ${parallel.nativeTaskCount}; runner-owned writable lanes: ${parallel.runnerOwnedWritableTaskCount}`,
    parallel.blockedReasons.length ? `Fanout blocked by: ${formatList(parallel.blockedReasons)}` : "",
    parallel.activeStage ? `Fanout stage: ${parallel.activeStage}` : "",
    parallel.orchestrationLevel ? `Orchestration level: ${parallel.orchestrationLevel}` : "",
    parallel.repositoryRouting?.reason
      ? `Repository routing: ${parallel.repositoryRouting.reason}, writableSafe=${parallel.repositoryRouting.writableSafe ? "yes" : "no"}`
      : "",
    `Goal persistence: ${goalPolicy.persistedGoalMutation}; continuation owner: ${goalPolicy.continuationOwner}`,
    parallel.intentHorizon?.enabled
      ? `[Intent Horizon contract] version=${parallel.intentHorizon.version} sweep=required-once candidates=${parallel.intentHorizon.sweep.maxCandidates} auto_apply=${parallel.intentHorizon.sweep.maxAutoApply} causal_depth=${parallel.intentHorizon.sweep.maxCausalDepth}`
      : "",
    route.typedEvidence.authoritative ? `Typed evidence authority: ${route.typedEvidence.activeStage}` : "",
    ...formatLaneAssignments(surface, parallel),
  ].filter(Boolean);

  const bodyText = bodyLines.join("\n");
  const bodyHash = sha256(bodyText);

  if (state && state.lastEmittedHash && state.lastEmittedHash === bodyHash) {
    return "[MyOS Dispatch route] unchanged from previous injection this turn.";
  }

  if (state) {
    state.lastEmittedHash = bodyHash;
  }

  let footerLines;
  if (state && state.footerEmittedInTurn) {
    footerLines = [
      "",
      "Mandatory behavior: unchanged (see route block earlier this turn)",
    ];
  } else {
    footerLines = [
      "",
      "Mandatory behavior:",
      "- Treat this route as the first routing pass for the turn.",
      "- Follow MyOS Dispatch evaluation order before broad search or provider-specific work.",
      "- For non-trivial work, use the maximum safe fanout exposed by the plan, while respecting protected-surface, auth, destructive, and user-visible-send gates.",
      ...fanoutMandateLines(surface, parallel, autoDispatchedTasks),
      ...(parallel.intentHorizon?.enabled ? [
        "- After the requested outcome verifies, run the required one-time Intent Horizon exploratory sweep across the routed project and direct call-graph neighborhood.",
        `- Generate up to ${parallel.intentHorizon.sweep.maxCandidates} concrete upgrades and implement the highest-scoring ${parallel.intentHorizon.sweep.maxAutoApply} that pass the ownership, reversibility, authority, and binary-verification gates.`,
        "- Upgrade hunting is required, but bounded: causal depth <= 2, one sweep only, and upgrades may create repairs but never another sweep.",
        "- Do not report a related bug, failed check, or qualified upgrade as a recommendation when it can be fixed safely now. Fix it, verify it, then report what changed.",
      ] : []),
      "- If the route is wrong, correct it explicitly and continue through the next practical verification or fix step.",
    ];
    if (state) {
      state.footerEmittedInTurn = true;
    }
  }

  return `${bodyText}\n${footerLines.join("\n")}`;
}

function formatCompactDispatchContext({ surface, plan, autoDispatchedTasks = [] }) {
  const route = compactRoute(plan);
  const parallel = route.parallelization;
  const lane = route.route.lane || "worker_skill";
  const fan = `${parallel.mode}/${parallel.aggression} depth=${parallel.depth} lanes=${parallel.nativeTaskCount}native+${parallel.runnerOwnedWritableTaskCount}runner/${parallel.maxSidecars ?? "?"} join=${parallel.joinPolicy}`;
  const roles = parallel.tasks
    .filter((task) => task.mode !== "workspace_write")
    .map((task) => `${task.id}:${task.agentProfile || task.role}`)
    .join(",");
  const lines = [
    `[MyOS Dispatch] surface=${surface} lane=${lane} intent=${route.intentType || "?"} ` +
      `project=${route.projectSlug || "none"} fanout=${fan}` +
      (route.blockedBy.length ? ` blocked=${formatList(route.blockedBy)}` : "") +
      (parallel.blockedReasons.length ? ` fanout_blocked=${formatList(parallel.blockedReasons)}` : ""),
    "Route through MyOS Dispatch evaluation order before broad search; respect protected-surface/auth/destructive/send gates.",
    parallel.intentHorizon?.enabled
      ? `[Intent Horizon contract] ${parallel.intentHorizon.version} sweep=required-once candidates=${parallel.intentHorizon.sweep.maxCandidates} auto_apply=${parallel.intentHorizon.sweep.maxAutoApply} depth=${parallel.intentHorizon.sweep.maxCausalDepth}`
      : "",
    roles ? `Read-only lanes: ${roles}` : "",
  ];
  if (parallel.mode !== "none" && parallel.nativeTaskCount > 0) {
    if (autoDispatchedTasks.length > 0) {
      const autoIds = autoDispatchedTasks.map((t) => t.id).join(", ");
      lines.push(
        `Mandatory fanout: ${autoDispatchedTasks.length} read-only lane(s) (${autoIds}) are ALREADY RUNNING in the background and results will arrive next turn. Do not re-spawn them; work the critical path.`
      );
      const remainingTasks = (parallel.tasks || []).filter(
        (t) => !autoDispatchedTasks.some((a) => a.id === t.id)
      );
      if (remainingTasks.length > 0) {
        const remIds = remainingTasks.map((t) => t.id).join(", ");
        lines.push(`Launch remaining ${remainingTasks.length} lane(s) (${remIds}) as parallel Agent calls.`);
      }
    } else {
      lines.push(
        surface === "codex"
          ? `Mandatory fanout: spawn ${parallel.nativeTaskCount} read-only native subagent threads for the listed lanes now; keep writable lanes runner-owned.`
          : `Mandatory fanout: launch ${parallel.nativeTaskCount} read-only parallel subagents for the listed lanes now.`
      );
    }
  }
  return lines.filter(Boolean).join("\n");
}

function buildContextForMode({ surface, hookEventName, targetKind, text, plan, contextMode, autoDispatchedTasks = [], state = null }) {
  if (contextMode === "none") return "";
  if (contextMode === "compact") return formatCompactDispatchContext({ surface, plan, autoDispatchedTasks });
  return formatDispatchContext({ surface, hookEventName, targetKind, text, plan, autoDispatchedTasks, state });
}

function resolveHookPlan(text, options = {}) {
  const env = {
    ...process.env,
    MYOS_BACKGROUND_ORCHESTRATOR: process.env.MYOS_BACKGROUND_ORCHESTRATOR || "myos-dispatch",
  };
  return resolveDispatchPlan(text, {
    ...options,
    env,
  });
}

function buildDispatchContext({ surface, hookEventName, targetKind, text, contextMode = "full", autoDispatchedTasks = [], state = null }) {
  const plan = resolveHookPlan(text, { hookSurface: surface, hookEventName });
  return {
    context: buildContextForMode({ surface, hookEventName, targetKind, text, plan, contextMode, autoDispatchedTasks, state }),
    route: compactRoute(plan),
  };
}

function appendRouteLog(record) {
  try {
    const logDir = process.env.MYOS_DISPATCH_HOOK_LOG_DIR || resolveLogsRoot();
    fs.mkdirSync(logDir, { recursive: true });
    const logPath = path.join(logDir, "myos-dispatch-hooks.jsonl");
    fs.appendFileSync(logPath, `${JSON.stringify(record)}\n`, "utf8");
  } catch {
    // Hook logging must never block the agent surface.
  }
}

function loadSidecarManifest(manifestPath) {
  try {
    if (fs.existsSync(manifestPath)) {
      const raw = fs.readFileSync(manifestPath, "utf8");
      const parsed = JSON.parse(raw);
      return {
        delivered: Array.isArray(parsed?.delivered) ? parsed.delivered : [],
        dispatched: Array.isArray(parsed?.dispatched) ? parsed.dispatched : [],
      };
    }
  } catch {}
  return { delivered: [], dispatched: [] };
}

function saveSidecarManifest(manifestPath, manifest) {
  try {
    fs.mkdirSync(path.dirname(manifestPath), { recursive: true });
    fs.writeFileSync(manifestPath, JSON.stringify(manifest, null, 2), "utf8");
  } catch {}
}

function collectAndMarkDeliveredResults(sidecarResultsDir, manifestPath) {
  if (!fs.existsSync(sidecarResultsDir)) return "";
  const manifest = loadSidecarManifest(manifestPath);
  const deliveredSet = new Set(manifest.delivered);

  let files = [];
  try {
    files = fs.readdirSync(sidecarResultsDir);
  } catch {
    return "";
  }

  const readyResults = [];
  for (const file of files) {
    if (!file.endsWith(".json") || file === "manifest.json") continue;
    const laneId = path.basename(file, ".json");
    if (deliveredSet.has(laneId)) continue;

    const fullPath = path.join(sidecarResultsDir, file);
    try {
      const content = fs.readFileSync(fullPath, "utf8");
      const parsed = JSON.parse(content);
      // Worker CLIs emit terminal control sequences on stdout, and the first live
      // auto-fanout delivered summaries that were pure OSC window-title escapes
      // (ESC ]0;Working - MyOS - Codex BEL). Strip escapes and control bytes
      // before this reaches a prompt, and fall back when nothing legible remains.
      const rawSummary = parsed.summary || parsed.errorMessage || "Result ready";
      const summary = String(rawSummary)
        .replace(/\u001B\][^\u0007\u001B]*(?:\u0007|\u001B\\)/g, "")
        .replace(/\u001B\[[0-9;?]*[ -/]*[@-~]/g, "")
        .replace(/[\u0000-\u0008\u000B-\u001F\u007F]/g, " ")
        .replace(/\s+/g, " ")
        .trim();
      readyResults.push({
        laneId: parsed.id || parsed.taskId || laneId,
        // A lane that produced nothing legible still gets delivered, so the
        // orchestrator knows it finished and can open the file itself.
        summary: summary.length >= 8 ? summary : "result ready (see file)",
        path: fullPath,
      });
    } catch {
      // Ignore unparseable or incomplete files
    }
  }

  if (readyResults.length === 0) return "";

  const maxLines = 14;
  const itemsToInclude = readyResults.slice(0, maxLines);
  const lines = [`Sidecar results ready (${readyResults.length}):`];
  for (const item of itemsToInclude) {
    lines.push(`${item.laneId}: ${item.summary} (full: ${item.path})`);
  }
  if (readyResults.length > maxLines) {
    lines.push(`... and ${readyResults.length - maxLines} more sidecar results`);
  }

  for (const item of readyResults) {
    if (!manifest.delivered.includes(item.laneId)) {
      manifest.delivered.push(item.laneId);
    }
  }
  saveSidecarManifest(manifestPath, manifest);

  return lines.join("\n");
}

// Preference order when nothing is pinned. codex first because it is the strongest
// at bounded read-only scouting; the rest are used if that is what the machine has.
const BACKGROUND_PROVIDER_PREFERENCE = ["codex", "claude", "antigravity", "gemini"];

function commandExists(cmd) {
  if (!cmd) return false;
  if (path.isAbsolute(cmd)) return fs.existsSync(cmd);
  try {
    const res = spawnSync("which", [cmd], { encoding: "utf8", timeout: 1000 });
    return res.status === 0 && Boolean(res.stdout.trim());
  } catch {
    return false;
  }
}

// Resolve the provider that will ACTUALLY be spawned, and return null when the
// machine has none.
//
// This used to guess from the surface: on Claude Code it checked `which claude`,
// while bin/myos-sidecar.js separately defaulted to codex. Anyone with claude and
// no codex therefore passed the gate and had every lane die with
// `spawn codex ENOENT`. Two independent defaults that were free to disagree, and
// they did. Reported from the field by Nicola Harvey against v3.5.1.
//
// The resolved value is passed to the sidecar explicitly with --provider, so the
// thing that was checked is the thing that runs.
function resolveBackgroundProvider() {
  const pinned = process.env.MYOS_BACKGROUND_PROVIDER || process.env.MYOS_LOCAL_WORKER;
  if (pinned) return commandExists(pinned) ? pinned : null;
  for (const candidate of BACKGROUND_PROVIDER_PREFERENCE) {
    if (commandExists(candidate)) return candidate;
  }
  return null;
}

function isWorkerCliAvailable() {
  if (process.env.MYOS_SIDECAR_BIN) {
    return fs.existsSync(process.env.MYOS_SIDECAR_BIN);
  }
  return resolveBackgroundProvider() !== null;
}

function countDispatchedInLastHour(manifest) {
  const now = Date.now();
  const oneHourMs = 60 * 60 * 1000;
  return (manifest.dispatched || []).filter((item) => {
    const ts = typeof item === "object" ? (item.timestamp || item.at) : null;
    const time = typeof ts === "number" ? ts : Date.parse(ts || "");
    return Number.isFinite(time) && now - time < oneHourMs;
  }).length;
}

function spawnSidecarTask(task, sidecarResultsDir, cwd) {
  try {
    fs.mkdirSync(sidecarResultsDir, { recursive: true });
    const resultFile = path.join(sidecarResultsDir, `${task.id}.json`);
    const logFile = path.join(sidecarResultsDir, `${task.id}.log`);
    const outFd = fs.openSync(logFile, "a");
    const errFd = fs.openSync(logFile, "a");

    const targetCwd =
      (task.scope && fs.existsSync(task.scope)) ? task.scope :
      (cwd && fs.existsSync(cwd)) ? cwd :
      process.cwd();

    const sidecarBin = process.env.MYOS_SIDECAR_BIN;
    let command;
    let args;

    if (sidecarBin) {
      if (sidecarBin.endsWith(".js")) {
        command = process.execPath;
        args = [
          sidecarBin,
          task.prompt || "",
          "--scope",
          targetCwd,
          "--id",
          task.id,
          "--out",
          resultFile,
        ];
      } else {
        command = sidecarBin;
        args = [
          task.prompt || "",
          "--scope",
          targetCwd,
          "--id",
          task.id,
          "--out",
          resultFile,
        ];
      }
      if (task.executionEnvelope) {
        args.push("--envelope", JSON.stringify(task.executionEnvelope));
      }
    } else {
      command = process.execPath;
      args = [
        path.join(__dirname, "myos-sidecar.js"),
        task.prompt || "",
        "--scope",
        targetCwd,
        "--id",
        task.id,
        "--out",
        resultFile,
      ];
      // Pass the provider the gate actually verified. Without this the sidecar
      // falls back to its own default and can spawn a binary this machine does
      // not have, which is how every lane died with ENOENT on a machine that had
      // claude but not codex.
      const resolvedProvider = resolveBackgroundProvider();
      if (resolvedProvider) args.push("--provider", resolvedProvider);
      if (task.executionEnvelope) {
        args.push("--envelope", JSON.stringify(task.executionEnvelope));
      }
    }

    const childEnv = { ...process.env };
    delete childEnv.MYOS_BACKGROUND_IS_SIDECAR;
    delete childEnv.MYOS_SIDECAR_ORCHESTRATED;
    childEnv.MYOS_SIDECAR_CLI_ALLOWED = "1";
    childEnv.MYOS_SIDECAR_RUN_ID = childEnv.MYOS_SIDECAR_RUN_ID || `sidecar-run-${Date.now()}`;
    childEnv.MYOS_SIDECAR_ORCHESTRATOR_TOKEN = childEnv.MYOS_SIDECAR_ORCHESTRATOR_TOKEN || `sidecar-token-${Date.now()}`;

    const child = spawn(command, args, {
      cwd: targetCwd,
      env: childEnv,
      detached: true,
      stdio: ["ignore", outFd, errFd],
    });
    child.unref();
    try { fs.closeSync(outFd); } catch {}
    try { fs.closeSync(errFd); } catch {}
    return true;
  } catch {
    return false;
  }
}

function scanTranscriptForAgentCalls(transcriptPath) {
  if (!transcriptPath || typeof transcriptPath !== "string") return 0;
  try {
    if (!fs.existsSync(transcriptPath)) return 0;
    const stats = fs.statSync(transcriptPath);
    const bufferSize = Math.min(stats.size, 512 * 1024);
    const fd = fs.openSync(transcriptPath, "r");
    const buffer = Buffer.alloc(bufferSize);
    fs.readSync(fd, buffer, 0, bufferSize, stats.size - bufferSize);
    fs.closeSync(fd);
    const raw = buffer.toString("utf8");
    const lines = raw.split("\n").slice(-400);

    let lastUserIndex = -1;
    for (let i = lines.length - 1; i >= 0; i--) {
      const line = lines[i];
      if (
        line.includes('"type":"user"') ||
        line.includes('"type":"user_prompt"') ||
        line.includes('"type":"USER_INPUT"') ||
        line.includes('"role":"user"')
      ) {
        lastUserIndex = i;
        break;
      }
    }

    const linesToScan = lastUserIndex >= 0 ? lines.slice(lastUserIndex + 1) : lines;
    let agentCallCount = 0;
    for (const line of linesToScan) {
      if (!line) continue;
      if (
        line.includes('"name":"Agent"') ||
        line.includes('"name": "Agent"') ||
        line.includes('"tool_name":"Agent"') ||
        line.includes('"tool_name": "Agent"')
      ) {
        const matches = line.match(/"(?:tool_)?name"\s*:\s*"Agent"/g);
        if (matches) {
          agentCallCount += matches.length;
        }
      }
    }
    return agentCallCount;
  } catch {
    return 0;
  }
}

function unquoteToken(token) {
  if (!token) return token;
  if (
    (token.startsWith("'") && token.endsWith("'")) ||
    (token.startsWith('"') && token.endsWith('"'))
  ) {
    return token.slice(1, -1);
  }
  return token;
}

function hasGrepPathOperand(args) {
  let hasPatternOption = false;
  const nonOptionArgs = [];
  let i = 0;
  let inOptions = true;

  while (i < args.length) {
    const arg = unquoteToken(args[i]);

    if (!inOptions) {
      nonOptionArgs.push(arg);
      i++;
      continue;
    }

    if (arg === "--") {
      inOptions = false;
      i++;
      continue;
    }

    if (arg.startsWith("--")) {
      if (arg.includes("=")) {
        const optName = arg.slice(0, arg.indexOf("="));
        if (optName === "--regexp" || optName === "--file") {
          hasPatternOption = true;
        }
        i++;
      } else if (
        arg === "--regexp" ||
        arg === "--file" ||
        arg === "--after-context" ||
        arg === "--before-context" ||
        arg === "--context" ||
        arg === "--max-count" ||
        arg === "--exclude" ||
        arg === "--exclude-from" ||
        arg === "--exclude-dir" ||
        arg === "--include" ||
        arg === "--label" ||
        arg === "--directories" ||
        arg === "--devices" ||
        arg === "--binary-files" ||
        arg === "--color" ||
        arg === "--colour"
      ) {
        if (arg === "--regexp" || arg === "--file") {
          hasPatternOption = true;
        }
        i++;
        if (i < args.length && !args[i].startsWith("-")) {
          i++;
        }
      } else {
        i++;
      }
      continue;
    }

    if (arg.startsWith("-") && arg.length > 1) {
      let j = 1;
      let consumedNext = false;
      while (j < arg.length) {
        const char = arg[j];
        if (
          char === "e" ||
          char === "f" ||
          char === "A" ||
          char === "B" ||
          char === "C" ||
          char === "m" ||
          char === "d" ||
          char === "D"
        ) {
          if (char === "e" || char === "f") {
            hasPatternOption = true;
          }
          if (j + 1 < arg.length) {
            j = arg.length;
          } else {
            consumedNext = true;
          }
          break;
        }
        j++;
      }
      i++;
      if (consumedNext) {
        i++;
      }
      continue;
    }

    nonOptionArgs.push(arg);
    i++;
  }

  if (hasPatternOption) {
    return nonOptionArgs.length > 0;
  }
  return nonOptionArgs.length > 1;
}

function tokenizeShellCommand(cmd) {
  const tokens = [];
  let currentToken = "";
  let inSingleQuote = false;
  let inDoubleQuote = false;
  let escaped = false;
  let hasComplexSyntax = false;

  for (let i = 0; i < cmd.length; i++) {
    const char = cmd[i];

    if (escaped) {
      currentToken += char;
      escaped = false;
      continue;
    }

    if (char === "\\") {
      if (inSingleQuote) {
        currentToken += char;
      } else {
        escaped = true;
      }
      continue;
    }

    if (char === "'" && !inDoubleQuote) {
      inSingleQuote = !inSingleQuote;
      currentToken += char;
      continue;
    }

    if (char === '"' && !inSingleQuote) {
      inDoubleQuote = !inDoubleQuote;
      currentToken += char;
      continue;
    }

    if (inSingleQuote || inDoubleQuote) {
      if (char === "`" || (char === "$" && i + 1 < cmd.length && cmd[i + 1] === "(")) {
        hasComplexSyntax = true;
      }
      currentToken += char;
      continue;
    }

    if (
      char === "`" ||
      (char === "$" && i + 1 < cmd.length && cmd[i + 1] === "(") ||
      (char === "<" && i + 1 < cmd.length && (cmd[i + 1] === "(" || cmd[i + 1] === "<"))
    ) {
      hasComplexSyntax = true;
    }

    if (char === "|" || char === "&" || char === ";" || char === "\n") {
      if (currentToken) {
        tokens.push(currentToken);
        currentToken = "";
      }
      if (
        (char === "|" && i + 1 < cmd.length && (cmd[i + 1] === "|" || cmd[i + 1] === "&")) ||
        (char === "&" && i + 1 < cmd.length && cmd[i + 1] === "&")
      ) {
        tokens.push(char + cmd[i + 1]);
        i++;
      } else {
        tokens.push(char);
      }
      continue;
    }

    if (/\s/.test(char)) {
      if (currentToken) {
        tokens.push(currentToken);
        currentToken = "";
      }
      continue;
    }

    currentToken += char;
  }

  if (escaped || inSingleQuote || inDoubleQuote) {
    hasComplexSyntax = true;
  }

  if (currentToken) {
    tokens.push(currentToken);
  }

  return { tokens, hasComplexSyntax };
}

const GREP_COMMANDS = new Set(["grep", "egrep", "fgrep", "rgrep"]);

function shouldRejectGrepRewrite(commandStr) {
  if (!commandStr || typeof commandStr !== "string") return false;
  if (!/\b(rtk\s+)?(grep|egrep|fgrep|rgrep)\b/.test(commandStr)) {
    return false;
  }

  try {
    const { tokens, hasComplexSyntax } = tokenizeShellCommand(commandStr);
    if (hasComplexSyntax) {
      return true;
    }

    const sequences = [];
    let currentSeq = [];
    for (const token of tokens) {
      if (token === ";" || token === "&&" || token === "||" || token === "&" || token === "\n") {
        if (currentSeq.length) {
          sequences.push(currentSeq);
          currentSeq = [];
        }
      } else {
        currentSeq.push(token);
      }
    }
    if (currentSeq.length) {
      sequences.push(currentSeq);
    }

    for (const seq of sequences) {
      const stages = [];
      let currentStage = [];
      for (const token of seq) {
        if (token === "|" || token === "|&") {
          stages.push(currentStage);
          currentStage = [];
        } else {
          currentStage.push(token);
        }
      }
      if (currentStage.length) {
        stages.push(currentStage);
      }

      for (let i = 0; i < stages.length; i++) {
        const stage = stages[i];
        if (!stage.length) continue;

        let execIndex = 0;
        while (execIndex < stage.length && /^[A-Za-z_][A-Za-z0-9_]*=/.test(stage[execIndex])) {
          execIndex++;
        }
        if (execIndex < stage.length && unquoteToken(stage[execIndex]) === "rtk") {
          execIndex++;
        }
        if (execIndex >= stage.length) continue;

        const rawExec = unquoteToken(stage[execIndex]);
        const execName = path.basename(rawExec);

        if (GREP_COMMANDS.has(execName)) {
          if (i > 0) {
            return true;
          }
          const args = stage.slice(execIndex + 1);
          if (!hasGrepPathOperand(args)) {
            return true;
          }
        }
      }
    }
  } catch {
    return true;
  }

  return false;
}

function isRtkRewriteSafe(originalCommand, updatedCommand) {
  if (shouldRejectGrepRewrite(originalCommand)) return false;
  if (shouldRejectGrepRewrite(updatedCommand)) return false;
  return true;
}

function buildRtkRewrite(payload) {
  const command = readCommand(payload);
  if (!command) return null;
  const input = JSON.stringify({
    ...payload,
    tool_input: {
      ...readToolInput(payload),
      command,
    },
  });
  const result = spawnSync("rtk", ["hook", "claude"], {
    input,
    encoding: "utf8",
    timeout: 5000,
    env: process.env,
  });
  if (result.status !== 0 || !result.stdout.trim()) return null;
  try {
    const parsed = JSON.parse(result.stdout);
    const updated = parsed?.hookSpecificOutput?.updatedInput;
    if (updated && typeof updated.command === "string" && updated.command.trim()) {
      if (isRtkRewriteSafe(command, updated.command)) {
        return updated;
      }
    }
  } catch {
    return null;
  }
  return null;
}

function outputHookContext(hookEventName, context, extra = {}) {
  return {
    hookSpecificOutput: {
      hookEventName,
      ...(context ? { additionalContext: context } : {}),
      ...extra,
    },
  };
}

function handleUserPromptSubmit(payload, surface, options = {}) {
  const text = readPromptText(payload);
  if (!text) return null;

  if (/^h$/i.test(text.trim())) {
    appendRouteLog({
      at: new Date().toISOString(),
      surface,
      hookEventName: "UserPromptSubmit",
      targetKind: "user_prompt",
      inputHash: `sha256:${sha256(text)}`,
      inputLength: text.length,
      cwd: safeString(payload.cwd || process.cwd()),
      route: "ping_shortcut",
      capabilityId: null,
      branch: null,
      lanesAutoDispatched: 0,
      agentCallsObserved: 0,
    });
    return { decision: "block", reason: "ping" };
  }

  const sessionId = readSessionId(payload);
  const homeRoot = preferredHomeRoot();
  const sidecarResultsDir = path.join(homeRoot, "state", "sidecar-results", sessionId);
  const manifestPath = path.join(sidecarResultsDir, "manifest.json");

  const sidecarResultsText = collectAndMarkDeliveredResults(sidecarResultsDir, manifestPath);

  const plan = resolveHookPlan(text, { hookSurface: surface, hookEventName: "UserPromptSubmit" });
  const routeObj = compactRoute(plan);

  const manifest = loadSidecarManifest(manifestPath);

  const autoFanoutEnabled =
    String(process.env.MYOS_AUTO_FANOUT || "1") !== "0" &&
    String(process.env.MYOS_BACKGROUND_AGENTS_ENABLED || "1") !== "0";

  const goalScale = Number(plan.goalScale || routeObj.goalScale || 0);
  const rawTasks = plan.parallelizationPlan?.backgroundTasks || [];
  const readOnlyTasks = rawTasks.filter((t) => t.mode !== "workspace_write");

  let autoDispatchedTasks = [];
  if (
    autoFanoutEnabled &&
    goalScale >= 3 &&
    readOnlyTasks.length > 0 &&
    isWorkerCliAvailable()
  ) {
    const dispatchedInLastHour = countDispatchedInLastHour(manifest);
    const availableCap = Math.min(3, 6 - dispatchedInLastHour);
    if (availableCap > 0) {
      const candidates = readOnlyTasks.slice(0, availableCap);
      for (const task of candidates) {
        const spawned = spawnSidecarTask(task, sidecarResultsDir, payload.cwd || process.cwd());
        if (spawned) {
          autoDispatchedTasks.push(task);
          manifest.dispatched.push({ id: task.id, timestamp: Date.now() });
        }
      }
      if (autoDispatchedTasks.length > 0) {
        saveSidecarManifest(manifestPath, manifest);
      }
    }
  }

  const rawSessionId = getRawSessionId(payload);
  let state = rawSessionId ? loadRouteContextState(rawSessionId) : null;
  if (rawSessionId) {
    if (!state) {
      state = { turn: 0, footerEmittedInTurn: false, lastEmittedHash: null };
    }
    state.turn += 1;
    state.footerEmittedInTurn = false;
    state.lastEmittedHash = null;
  }

  let routeContextText = buildContextForMode({
    surface,
    hookEventName: "UserPromptSubmit",
    targetKind: "user_prompt",
    text,
    plan,
    contextMode: options.contextMode || "full",
    autoDispatchedTasks,
    state,
  });

  if (rawSessionId && state) {
    saveRouteContextState(rawSessionId, state);
  }

  if (sidecarResultsText) {
    routeContextText = routeContextText
      ? `${routeContextText}\n\n${sidecarResultsText}`
      : sidecarResultsText;
  }

  const transcriptPath = payload.transcript_path || payload.transcriptPath;
  const agentCallsObserved = scanTranscriptForAgentCalls(transcriptPath);

  appendRouteLog({
    at: new Date().toISOString(),
    surface,
    hookEventName: "UserPromptSubmit",
    targetKind: "user_prompt",
    inputHash: `sha256:${sha256(text)}`,
    inputLength: text.length,
    cwd: safeString(payload.cwd || process.cwd()),
    route: routeObj.route,
    // The prompt record logged only the inner {lane, reason}. "worker_skill" is not
    // something the evolver can propose a fast path for, and inputHash only matches
    // byte-identical prompts, so no faithful bridge from this log to the observer was
    // possible and the learning loop had no signal at all. These two fields are what
    // make a repeated route countable.
    capabilityId: routeObj.capabilityId || null,
    branch: routeObj.branch || null,
    intentHorizon: routeObj.parallelization?.intentHorizon || null,
    lanesAutoDispatched: autoDispatchedTasks.length,
    agentCallsObserved,
    ...(routeObj.fastpaths ? { fastpaths: routeObj.fastpaths } : {}),
  });

  return outputHookContext("UserPromptSubmit", routeContextText);
}

function handlePreToolUse(payload, surface, options = {}) {
  const toolName = readToolName(payload);
  const command = readCommand(payload);
  if (toolName && toolName !== "Bash") return null;
  if (!command) return null;

  const rawSessionId = getRawSessionId(payload);
  let state = rawSessionId ? loadRouteContextState(rawSessionId) : null;
  if (rawSessionId && !state) {
    state = { turn: 1, footerEmittedInTurn: false, lastEmittedHash: null };
  }

  const route = buildDispatchContext({
    surface,
    hookEventName: "PreToolUse",
    targetKind: "bash_command",
    text: command,
    contextMode: options.contextMode || "full",
    state,
  });

  if (rawSessionId && state) {
    saveRouteContextState(rawSessionId, state);
  }

  appendRouteLog({
    at: new Date().toISOString(),
    surface,
    hookEventName: "PreToolUse",
    targetKind: "bash_command",
    inputHash: `sha256:${sha256(command)}`,
    inputLength: command.length,
    cwd: safeString(payload.cwd || process.cwd()),
    route: route.route,
    intentHorizon: route.route?.parallelization?.intentHorizon || null,
    ...(route.route?.fastpaths ? { fastpaths: route.route.fastpaths } : {}),
  });
  const updatedInput = options.rewrite ? buildRtkRewrite(payload) : null;
  // Route evidence is already logged above. When there is nothing actionable
  // (no rewrite and no context to inject), stay a true no-op so the PreToolUse
  // surface behaves exactly like the bare rewrite hook it replaces.
  if (!updatedInput && !route.context) return null;
  return outputHookContext("PreToolUse", route.context, {
    ...(updatedInput ? { updatedInput } : {}),
  });
}

function handleHookPayload(payload, surface = readSurface(), options) {
  const hookEventName = readHookEventName(payload);
  const opts = options || { contextMode: readContextMode(), rewrite: readRewriteEnabled() };
  try {
    if (hookEventName === "UserPromptSubmit") {
      return handleUserPromptSubmit(payload, surface, opts);
    }
    if (hookEventName === "PreToolUse") {
      return handlePreToolUse(payload, surface, opts);
    }
    return null;
  } catch (error) {
    return outputHookContext(hookEventName || "Unknown", [
      "[MyOS Dispatch route]",
      `Surface: ${surface}`,
      `Hook event: ${hookEventName || "unknown"}`,
      `Dispatch hook error: ${error instanceof Error ? error.message : String(error)}`,
      "Fail-open behavior: continue the turn, but route manually through MYOS-DISPATCH.md before substantive work.",
    ].join("\n"));
  }
}

function renderRouteFromStdin() {
  // CLI mode for wrappers (e.g. bin/codex): stdin is raw prompt text, output
  // is the plain full route block, ready to prepend to an agent prompt.
  const text = readStdin().trim();
  if (!text) return;
  const { context } = buildDispatchContext({
    surface: readSurface(),
    hookEventName: "UserPromptSubmit",
    targetKind: "user_prompt",
    text,
    contextMode: "full",
  });
  if (context) process.stdout.write(`${context}\n`);
}

function main() {
  if (readArg("--render-route") === "1") {
    try {
      renderRouteFromStdin();
    } catch {
      // Fail open: wrappers must never block on route rendering.
    }
    return;
  }
  const payload = parseJsonInput(readStdin());
  const output = handleHookPayload(payload);
  if (output) {
    process.stdout.write(`${JSON.stringify(output)}\n`);
  }
}

if (require.main === module) {
  main();
}

module.exports = {
  compactRoute,
  formatDispatchContext,
  handleHookPayload,
  readHookEventName,
  readPromptText,
  readCommand,
  shouldRejectGrepRewrite,
  isRtkRewriteSafe,
};
