{
  "name": "myos-dispatch",
  "version": "4.0.0",
  "description": "Standalone MyOS Dispatch routing and execution core.",
  "type": "commonjs",
  "main": "src/workspace-context.js",
  "bin": {
    "myos-dispatch-hook": "bin/myos-dispatch-hook",
    "myos-local-search": "bin/myos-local-search.js",
    "myos-search-service": "bin/myos-search-service.js",
    "myos-search": "bin/myos-search.js",
    "myos-search-dispatch": "bin/myos-search-dispatch.js",
    "myos-writer": "bin/myos-writer.js"
  },
