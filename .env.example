# MyOS Dispatch public example environment.
# Copy values into your own local .env; never commit real secrets.

# Paths
MYOS_HOME_ROOT=
MYOS_WORKSPACE=
MYOS_SERVICE_NAMESPACE=myos-dispatch

# Queue / remote compute
MYOS_VPS_HOST=
QUEUE_API_URL=
QUEUE_API_KEY=

# Provider keys
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
OPENROUTER_API_KEY=

# Hook behavior
MYOS_DISPATCH_HOOK_SURFACE=codex
MYOS_DISPATCH_HOOK_CONTEXT=compact
MYOS_DISPATCH_HOOK_LOG_DIR=

# Routing / model runtime
MYOS_LLM_PROVIDER=
MYOS_API_PROVIDER=
MYOS_AUTH_MODE=
MYOS_MODEL_PROFILE_DEFAULT=
MYOS_MODEL_PROFILE_SMART=
MYOS_MODEL_PROFILE_BACKGROUND=
MYOS_USAGE_LEDGER_DIR=
MYOS_LANE_STATE_PATH=
MYOS_SPEND_POLICY_PATH=

# Parallelization
MYOS_BACKGROUND_AGENTS_ENABLED=1
MYOS_BACKGROUND_ORCHESTRATOR=
MYOS_BACKGROUND_WORKER=
MYOS_PARALLELIZATION_VERSION=
MYOS_PARALLELIZATION_AUTO_PROMOTE=0
MYOS_PARALLELIZATION_HEALTH_ENABLED=0
MYOS_PARALLELIZATION_STATE_FILE=
MYOS_PARALLELIZATION_MAX_AGENTS=
MYOS_PARALLELIZATION_AGGRESSION=
MYOS_OPTIONAL_SIDECAR_GRACE_MS=

# Dispatcher health
MYOS_DISPATCH_HEALTH_VERSION=
MYOS_DISPATCH_HEALTH_AUTO_PROMOTE=0
MYOS_DISPATCH_HEALTH_AUTO_REPAIR=0
MYOS_DISPATCH_HEALTH_STATE_FILE=

# Typed evidence shadow routing
MYOS_TYPED_EVIDENCE_SHADOW_ENABLED=1
MYOS_TYPED_EVIDENCE_SHADOW_VERSION=
MYOS_TYPED_EVIDENCE_SHADOW_AUTO_PROMOTE=0
MYOS_TYPED_EVIDENCE_SHADOW_STATE_FILE=
